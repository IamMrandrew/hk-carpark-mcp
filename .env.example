# Copy to a private .env outside Git, replace placeholders, and chmod 600.
# The app reads exported variables; it does not load .env files automatically.
CARPARK_PUBLIC_ORIGIN=https://carpark.example.test
CARPARK_CLIENT_REDIRECT_URI=https://grok.com/connectors-oauth-exchange-code/
CARPARK_DISPLAY_NAME="Example Carpark"
CARPARK_SHORT_NAME=Carpark
CARPARK_ICON_TEXT=P
CARPARK_LISTEN_PORT=8767
CARPARK_POCKET_PORT=14110
CARPARK_STATE_DIR=/srv/carpark/state
CARPARK_POCKET_DATABASE=/srv/pocket-id/pocket.db
CARPARK_POCKET_CLIENT_SECRET_FILE=/run/secrets/carpark-pocket-client-secret
CARPARK_POCKET_CLIENT_ID=replace-with-your-pocket-client-id
CARPARK_ALLOWED_SUB=replace-with-your-owner-subject
# Optional JSON array of additional immutable Pocket user IDs (not usernames).
CARPARK_ADDITIONAL_ALLOWED_SUBS='[]'
# Set both from the separately verified Pocket database file. No guessed defaults.
CARPARK_POCKET_DB_DEVICE=
CARPARK_POCKET_DB_INODE=

# Optional operator/runbook values. These are not read by the Python server.
CARPARK_ENV_FILE=/etc/carpark/server.env
CARPARK_SSH_HOST=home-host.example.test
CARPARK_SSH_USER=service-user
CARPARK_INSTALL_DIR=/srv/carpark
CARPARK_BACKUP_DIR=/srv/backups/carpark
POCKET_TEST_BINARY=/opt/pocket-id/pocket-id-v2.17.0
